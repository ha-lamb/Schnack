<Window x:Class="Schnack.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Schnack.Views"
        xmlns:loc="clr-namespace:Schnack.Localization"
        Title="{x:Static loc:Strings.Settings_Title}"
        Height="760" Width="540"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:BoolToBrushConverter x:Key="ApiKeyStatusBrushConverter"
                                    TrueBrush="Green" FalseBrush="OrangeRed"/>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- ── Backend-Auswahl ─────────────────────────────────── -->
            <TextBlock Text="{x:Static loc:Strings.Settings_Backend}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,14">
                <StackPanel>
                    <RadioButton Content="{x:Static loc:Strings.Settings_BackendOpenAi}"
                                 IsChecked="{Binding IsOpenAiBackend}"
                                 Margin="0,0,0,4"/>
                    <RadioButton Content="{x:Static loc:Strings.Settings_BackendClaude}"
                                 IsChecked="{Binding IsClaudeBackend}"/>
                </StackPanel>
            </Border>

            <!-- ── OpenAI-Backend-Einstellungen ──────────────────── -->
            <StackPanel Visibility="{Binding IsOpenAiBackend, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{x:Static loc:Strings.Settings_OpenAiSection}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:Strings.Settings_SttModel}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                              ItemsSource="{Binding OpenAiSttModelOptions}"
                              SelectedItem="{Binding OpenAiTranscriptionModel}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:Strings.Settings_ChatModel}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding OpenAiChatModel, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </StackPanel>

            <!-- ── Claude-Backend-Einstellungen ──────────────────── -->
            <StackPanel Visibility="{Binding IsClaudeBackend, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{x:Static loc:Strings.Settings_ClaudeSection}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:Strings.Settings_ClaudeModel}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                             Text="{Binding ClaudeModel, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:Strings.Settings_MaxTokens}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding ClaudeMaxTokens, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <TextBlock Text="{x:Static loc:Strings.Settings_WhisperSection}" FontWeight="SemiBold" Margin="0,8,0,6"/>
                <Grid Margin="0,0,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:Strings.Settings_WhisperModel}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                              ItemsSource="{Binding WhisperModelOptions}"
                              SelectedItem="{Binding WhisperModel}"/>

                    <!-- GPU-Checkbox entfernt: CUDA-Runtime ist nicht referenziert, die Option wäre wirkungslos.
                         Setting WhisperUseGpu bleibt für eine spätere CUDA-Iteration erhalten. -->

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:Strings.Settings_WhisperStatus}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding WhisperDownloadStatus}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="{x:Static loc:Strings.Settings_Download}"
                                Command="{Binding DownloadWhisperModelCommand}"/>
                    </StackPanel>
                </Grid>
                <ProgressBar Value="{Binding WhisperDownloadProgress, Mode=OneWay}" Maximum="100" Height="6"
                             Margin="0,0,0,14"
                             Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- ── Globale Einstellungen ──────────────────────────── -->
            <TextBlock Text="{x:Static loc:Strings.Settings_GeneralSection}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:Strings.Settings_UiLanguage}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                          ItemsSource="{Binding LanguageOptions}"
                          DisplayMemberPath="Display"
                          SelectedItem="{Binding UiLanguage}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:Strings.Settings_DefaultMode}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                          ItemsSource="{Binding DictationOptions}"
                          DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedDictation}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static loc:Strings.Settings_Hotkey}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                         Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static loc:Strings.Settings_Microphone}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                          ItemsSource="{Binding MicrophoneOptions}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedMicrophone}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static loc:Strings.Settings_RestoreClipboard}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" VerticalAlignment="Center"
                          IsChecked="{Binding RestoreClipboard}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static loc:Strings.Settings_ClipboardFree}" VerticalAlignment="Top" Margin="0,2,0,10"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,10">
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding PreferClipboardFreeInsertion}"
                              Content="{x:Static loc:Strings.Settings_ClipboardFreeOption}"/>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                               Text="{x:Static loc:Strings.Settings_ClipboardFreeHint}"/>
                </StackPanel>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="{x:Static loc:Strings.Settings_DebugLogging}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <StackPanel Grid.Row="6" Grid.Column="1">
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding DebugLogging}"
                              Content="{x:Static loc:Strings.Settings_DebugLoggingOption}"/>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                               Text="{x:Static loc:Strings.Settings_DebugLoggingHint}"/>
                </StackPanel>
            </Grid>

            <!-- ── API-Keys ───────────────────────────────────────── -->
            <TextBlock Text="{x:Static loc:Strings.Settings_ApiKeysSection}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:Strings.Settings_AnthropicKey}" VerticalAlignment="Top" Margin="0,2,0,10"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="AnthropicApiKeyBox" Grid.Column="0" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="{x:Static loc:Strings.Common_Save}" Click="OnSaveAnthropicApiKeyClick"/>
                    </Grid>
                    <TextBlock Margin="0,4,0,0" FontSize="11"
                               Text="{Binding AnthropicApiKeyStatus}"
                               Foreground="{Binding IsAnthropicApiKeyStored, Converter={StaticResource ApiKeyStatusBrushConverter}}"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:Strings.Settings_OpenAiKey}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="OpenAiApiKeyBox" Grid.Column="0" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="{x:Static loc:Strings.Common_Save}" Click="OnSaveOpenAiApiKeyClick"/>
                    </Grid>
                    <TextBlock Margin="0,4,0,0" FontSize="11"
                               Text="{Binding OpenAiApiKeyStatus}"
                               Foreground="{Binding IsOpenAiApiKeyStored, Converter={StaticResource ApiKeyStatusBrushConverter}}"/>
                </StackPanel>
            </Grid>

            <TextBlock Margin="0,6,0,14"
                       TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                       Text="{x:Static loc:Strings.Settings_KeyHint}"/>

            <!-- ── Buttons ────────────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static loc:Strings.Common_Cancel}" Width="90" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick"/>
                <Button Content="{x:Static loc:Strings.Common_Save}" Width="90" IsDefault="True" Click="OnSaveClick"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
