<Window x:Class="Schnack.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Schnack.Views"
        xmlns:loc="clr-namespace:Schnack.Localization"
        Title="{x:Static loc:Strings.Settings_Title}"
        Height="560" Width="560"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:BoolToBrushConverter x:Key="ApiKeyStatusBrushConverter"
                                    TrueBrush="Green" FalseBrush="OrangeRed"/>

        <!-- Gemeinsame Stile: ein Ort für Abstände, Größen und Farben, damit die Reiter
             nicht auseinanderlaufen. Vorher lag all das verstreut an den Elementen. -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,10"/>
        </Style>

        <Style x:Key="FieldLabelTop" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,2,12,10"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="TabBody" TargetType="StackPanel">
            <Setter Property="Margin" Value="16,14,16,16"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Fußbereich außerhalb der Reiter: er darf nicht mitscrollen -->
        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,10">
                <Button Content="{x:Static loc:Strings.Common_Cancel}" Width="90" Margin="0,0,8,0"
                        IsCancel="True" Click="OnCancelClick"/>
                <Button Content="{x:Static loc:Strings.Common_Save}" Width="90"
                        IsDefault="True" Click="OnSaveClick"/>
            </StackPanel>
        </Border>

        <TabControl Margin="8">

            <!-- ══ Spracherkennung ══════════════════════════════════════ -->
            <TabItem Header="{x:Static loc:Strings.Settings_TabSpeech}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource TabBody}">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                   Text="{x:Static loc:Strings.Settings_SpeechIntro}"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="{x:Static loc:Strings.Settings_WhisperModel}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding WhisperModelOptions}"
                                      SelectedItem="{Binding WhisperModel}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="{x:Static loc:Strings.Settings_WhisperStatus}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{Binding WhisperDownloadStatus}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Content="{x:Static loc:Strings.Settings_Download}"
                                        Padding="10,3"
                                        Command="{Binding DownloadWhisperModelCommand}"/>
                            </StackPanel>
                        </Grid>

                        <ProgressBar Value="{Binding WhisperDownloadProgress, Mode=OneWay}" Maximum="100" Height="6"
                                     Margin="0,0,0,12"
                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>

                        <CheckBox Content="{x:Static loc:Strings.Settings_WhisperPreload}"
                                  IsChecked="{Binding WhisperPreload}" Margin="0,4,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="20,4,0,10"
                                   Text="{x:Static loc:Strings.Settings_WhisperPreloadHint}"/>

                        <CheckBox Content="{x:Static loc:Strings.Settings_WhisperUseGpu}"
                                  IsChecked="{Binding WhisperUseGpu}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="20,4,0,0"
                                   Text="{x:Static loc:Strings.Settings_WhisperUseGpuHint}"/>

                        <!-- Vokabular steht hier, weil es primär als Vorab-Kontext der Erkennung
                             wirkt; im Nachbearbeitungs-Prompt nur zusätzlich. -->
                        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,18,0,8"
                                   Text="{x:Static loc:Strings.Settings_VocabularySection}"/>
                        <TextBox Height="96"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Text="{Binding VocabularyText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,0"
                                   Text="{x:Static loc:Strings.Settings_VocabularyHint}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══ Nachbearbeitung ══════════════════════════════════════ -->
            <TabItem Header="{x:Static loc:Strings.Settings_TabPostProcessing}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource TabBody}">
                        <CheckBox Content="{x:Static loc:Strings.Settings_TextSmoothing}"
                                  IsChecked="{Binding TextSmoothing}"
                                  IsEnabled="{Binding IsTextSmoothingEnabled}"
                                  FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="20,4,0,0"
                                   Text="{x:Static loc:Strings.Settings_TextSmoothingHint}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="20,4,0,0" Foreground="#A0522D"
                                   Text="{x:Static loc:Strings.Settings_MissingKeyNote}"
                                   Visibility="{Binding ShowsMissingKeyNote, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,16,0,8"
                                   Text="{x:Static loc:Strings.Settings_AiService}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Content="{x:Static loc:Strings.Settings_ServiceOpenAi}"
                                         IsChecked="{Binding IsOpenAiService}" Margin="0,0,24,0"/>
                            <RadioButton Content="{x:Static loc:Strings.Settings_ServiceClaude}"
                                         IsChecked="{Binding IsClaudeService}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Modellfelder: nur das Paar des gewählten Dienstes -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="{x:Static loc:Strings.Settings_ChatModel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Visibility="{Binding IsOpenAiService, Converter={StaticResource BoolToVis}}"
                                     Text="{Binding OpenAiChatModel, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Visibility="{Binding IsClaudeService, Converter={StaticResource BoolToVis}}"
                                     Text="{Binding ClaudeModel, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="{x:Static loc:Strings.Settings_MaxTokens}"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Visibility="{Binding IsOpenAiService, Converter={StaticResource BoolToVis}}"
                                     Text="{Binding OpenAiChatMaxTokens, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Visibility="{Binding IsClaudeService, Converter={StaticResource BoolToVis}}"
                                     Text="{Binding ClaudeMaxTokens, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Genau EIN Schlüsselfeld: zwei Felder hießen, dass ein getippter
                                 Schlüssel im versteckten stehen bliebe und beim falschen Dienst landet. -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelTop}"
                                       Text="{x:Static loc:Strings.Settings_ApiKey}"/>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="ApiKeyBox" Grid.Column="0" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Padding="10,3"
                                            Content="{x:Static loc:Strings.Common_Save}"
                                            Click="OnSaveApiKeyClick"/>
                                </Grid>
                                <TextBlock Margin="0,4,0,0" FontSize="11"
                                           Text="{Binding ApiKeyStatus}"
                                           Foreground="{Binding IsApiKeyStored, Converter={StaticResource ApiKeyStatusBrushConverter}}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="{x:Static loc:Strings.Settings_KeyHint}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══ Bedienung ════════════════════════════════════════════ -->
            <TabItem Header="{x:Static loc:Strings.Settings_TabControls}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource TabBody}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="{x:Static loc:Strings.Settings_UiLanguage}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding LanguageOptions}"
                                      DisplayMemberPath="Display"
                                      SelectedItem="{Binding UiLanguage}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="{x:Static loc:Strings.Settings_Hotkey}"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="{x:Static loc:Strings.Settings_Microphone}"/>
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      ItemsSource="{Binding MicrophoneOptions}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedMicrophone}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelTop}"
                                       Text="{x:Static loc:Strings.Settings_RestoreClipboard}"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                                <CheckBox IsChecked="{Binding RestoreClipboard}"
                                          Content="{x:Static loc:Strings.Settings_RestoreClipboardOption}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabelTop}"
                                       Text="{x:Static loc:Strings.Settings_ClipboardFree}"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,10">
                                <CheckBox IsChecked="{Binding PreferClipboardFreeInsertion}"
                                          Content="{x:Static loc:Strings.Settings_ClipboardFreeOption}"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{x:Static loc:Strings.Settings_ClipboardFreeHint}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabelTop}"
                                       Text="{x:Static loc:Strings.Settings_DebugLogging}"/>
                            <StackPanel Grid.Row="5" Grid.Column="1">
                                <CheckBox IsChecked="{Binding DebugLogging}"
                                          Content="{x:Static loc:Strings.Settings_DebugLoggingOption}"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{x:Static loc:Strings.Settings_DebugLoggingHint}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
